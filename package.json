{
  "name": "singapore-social-services-rag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:api": "python -m uvicorn backend.local_app:app --host 127.0.0.1 --port 8000 --reload",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live-backend": "playwright test e2e/production-smoke.spec.ts --grep @live-backend",
    "test:e2e:production": "playwright test e2e/production-smoke.spec.ts --grep @production",
    "test:quality:live": "python -m evaluation.run_quality",
    "test:python": "python -m pytest -q",
    "test:python:coverage": "python -m pytest -q --cov=backend --cov=ingestion --cov=evaluation --cov-report=term-missing --cov-fail-under=100",
    "test:retrieval": "python -m pytest -q -m retrieval",
    "test:quality": "npm run typecheck && npm run lint && npm run test:coverage",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
