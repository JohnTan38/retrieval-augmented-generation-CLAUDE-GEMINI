{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,dist/**,src/**,public/assets/**,**/test_*.py,**/verify_rag.py,**/build_index.py,**/__pycache__/**,.pytest_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
